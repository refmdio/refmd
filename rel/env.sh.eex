#!/bin/sh

# Erlang distribution: long names required for cluster mode
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# Erlang cookie: must be shared across all cluster nodes
# Set RELEASE_COOKIE in deployment environment
# export RELEASE_COOKIE="shared-secret-cookie"

# Erlang distribution security (mandatory when clustering is enabled)
if [ -n "$CLUSTER_SERVICE_NAME" ]; then
  if [ -z "$RELEASE_COOKIE" ]; then
    echo "FATAL: Clustering is enabled (CLUSTER_SERVICE_NAME is set) but RELEASE_COOKIE is not set." >&2
    exit 1
  fi

  if [ -z "$ERLANG_DIST_TLS_CERTFILE" ] || [ -z "$ERLANG_DIST_TLS_KEYFILE" ] || [ -z "$ERLANG_DIST_TLS_CACERTFILE" ]; then
    echo "FATAL: Clustering is enabled (CLUSTER_SERVICE_NAME is set) but TLS certificates are not configured." >&2
    echo "Set ERLANG_DIST_TLS_CERTFILE, ERLANG_DIST_TLS_KEYFILE, and ERLANG_DIST_TLS_CACERTFILE." >&2
    exit 1
  fi

  INET_TLS_CONF="${RELEASE_TMP}/inet_tls.conf"
  sed -e "s|\${ERLANG_DIST_TLS_CERTFILE}|${ERLANG_DIST_TLS_CERTFILE}|g" \
      -e "s|\${ERLANG_DIST_TLS_KEYFILE}|${ERLANG_DIST_TLS_KEYFILE}|g" \
      -e "s|\${ERLANG_DIST_TLS_CACERTFILE}|${ERLANG_DIST_TLS_CACERTFILE}|g" \
      "${RELEASE_ROOT}/inet_tls.conf" > "${INET_TLS_CONF}"

  export ELIXIR_ERL_OPTIONS="-proto_dist inet_tls -ssl_dist_optfile ${INET_TLS_CONF}"
fi
